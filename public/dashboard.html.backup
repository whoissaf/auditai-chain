<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - AuditAI Chain</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-solidity.min.js"></script>
    <script>
        tailwind.config = {
            theme: { extend: { colors: { primary: '#3B82F6', dark: '#0F172A', surface: '#1E293B', critical: '#EF4444', high: '#F97316', medium: '#EAB308', low: '#3B82F6' } } }
        }
    </script>
</head>
<body class="bg-dark text-slate-200 font-sans min-h-screen">
    <nav class="border-b border-slate-700 p-4 bg-surface">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <h1 class="text-xl font-bold text-primary">🛡️ AuditAI Chain</h1>
            <div class="flex items-center gap-4">
                <span id="userName" class="text-sm text-slate-400"></span>
                <button onclick="logout()" class="text-sm text-red-400 hover:text-red-300">Logout</button>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto p-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-1 space-y-6">
            <div class="bg-surface p-6 rounded-xl border border-slate-700">
                <h2 class="text-lg font-bold mb-4">Audit Baru</h2>
                <form id="auditForm" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">Nama Kontrak</label>
                        <input type="text" id="contractName" value="VulnerableBank.sol" class="w-full bg-dark border border-slate-600 rounded-lg p-2 text-sm focus:ring-2 focus:ring-primary outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Versi Compiler</label>
                        <select id="compilerVersion" class="w-full bg-dark border border-slate-600 rounded-lg p-2 text-sm focus:ring-2 focus:ring-primary outline-none">
                            <option value="0.8.19">0.8.19</option>
                            <option value="0.8.20">0.8.20</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Source Code (Solidity)</label>
                        <textarea id="sourceCode" rows="12" required class="w-full bg-dark border border-slate-600 rounded-lg p-2 text-xs font-mono focus:ring-2 focus:ring-primary outline-none" placeholder="pragma solidity ^0.8.0;..."></textarea>
                    </div>
                    <button type="submit" id="submitBtn" class="w-full bg-primary hover:bg-blue-600 text-white font-bold py-2 rounded-lg transition flex items-center justify-center gap-2">
                        <span>Mulai Analisis AI</span>
                    </button>
                </form>
            </div>
        </div>

        <div class="lg:col-span-2">
            <div id="loadingState" class="hidden bg-surface p-8 rounded-xl border border-slate-700 text-center">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto mb-4"></div>
                <p class="text-lg font-medium">AI sedang menganalisis kode...</p>
                <p class="text-sm text-slate-400 mt-2">Mendeteksi Reentrancy, Access Control, dan Logic Flaws</p>
            </div>

            <div id="resultState" class="hidden space-y-6">
                <div class="bg-surface p-6 rounded-xl border border-slate-700 flex justify-between items-center">
                    <div>
                        <h2 class="text-xl font-bold" id="resultContractName">Contract</h2>
                        <p class="text-sm text-slate-400" id="resultMeta">0 lines • Completed</p>
                    </div>
                    <div class="text-right">
                        <div class="text-3xl font-bold" id="riskScore">0/100</div>
                        <p class="text-xs text-slate-400">Risk Score</p>
                        <button onclick="exportPDF()" class="mt-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold py-2 px-4 rounded-lg transition flex items-center gap-2 mx-auto lg:mx-0">
                            📄 Download PDF & Hash
                        </button>
                    </div>
                </div>

                <div id="findingsContainer" class="space-y-4"></div>
            </div>
        </div>
    </main>

    <script src="/js/app.js"></script>
</body>
</html>
